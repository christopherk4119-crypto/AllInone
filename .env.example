# REPLACE WITH YOUR FORM ENDPOINT
# e.g. https://formspree.io/f/abcdwxyz  (create a free form at formspree.io)
NEXT_PUBLIC_FORM_ENDPOINT=

# Set to "true" ONLY if your form endpoint accepts file uploads.
# Formspree file uploads require a paid plan. When false/empty, the
# "Add photos of the space" field is hidden.
NEXT_PUBLIC_FORM_ALLOWS_FILES=

# Your production URL (used for canonical URL, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.example.com
